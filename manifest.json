{
  "manifest_version": 3,
  "name": "TactaSuite NS Toolkit",
  "version": "1.0.0",
  "description": "Unified NetSuite developer toolkit — field explorer, search export, script analysis, and 30+ productivity tools.",
  "author": "Blane Maher",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeContent",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.netsuite.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.netsuite.com/app/*"],
      "js": [
        "shared/ns-utils.js",
        "shared/storage-utils.js",
        "shared/dom-utils.js",
        "shared/ns-bridge.js",
        "shared/theme-manager.js",
        "content/ns-page-detector.js",
        "content/router.js"
      ],
      "css": [
        "shared/theme-vars.css",
        "shared/tactasuite-ui.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netsuite.com/app/common/search/search.nl*"],
      "js": ["content/feature-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netsuite.com/app/common/search/searchresults.nl*"],
      "js": ["content/feature-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netsuite.com/app/accounting/transactions/*"],
      "js": ["content/feature-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netsuite.com/app/common/scripting/script.nl*"],
      "js": ["content/feature-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netsuite.com/app/common/workflow/setup/*"],
      "js": ["content/feature-loader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.netsuite.com/app/common/dataset/*",
        "https://*.netsuite.com/app/common/workbook/*"
      ],
      "js": ["content/feature-loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/ns-bridge.js",
        "content/features/**/*-client.js",
        "content/features/**/*.css",
        "content/features/ns-utils/nav-search/nav-search-pages.js"
      ],
      "matches": ["https://*.netsuite.com/*"]
    }
  ]
}
